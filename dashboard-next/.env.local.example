# ECG Monitor Dashboard - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# AWS Cognito Configuration
# These values come from your Terraform outputs after deploying the Cognito module

# AWS Region where your Cognito User Pool is deployed
NEXT_PUBLIC_AWS_REGION=us-east-1

# Cognito User Pool ID (from terraform output cognito_user_pool_id)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (from terraform output cognito_client_id)
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito Domain (optional, for Hosted UI)
# Format: https://{domain-prefix}.auth.{region}.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain-prefix.auth.us-east-1.amazoncognito.com

# OAuth Callback URLs (must match Terraform configuration)
# For local development
NEXT_PUBLIC_REDIRECT_SIGN_IN=http://localhost:3000/callback
NEXT_PUBLIC_REDIRECT_SIGN_OUT=http://localhost:3000/

# API Configuration (optional)
# API Gateway endpoint for ECG data
NEXT_PUBLIC_API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/v1

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_MFA=false
NEXT_PUBLIC_ENABLE_HOSTED_UI=false

# Development Settings
NODE_ENV=development
